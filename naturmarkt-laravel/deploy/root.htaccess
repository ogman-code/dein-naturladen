# Nur noetig, wenn der Hoster das Document Root NICHT auf den Ordner "public" setzen kann.
# Dann diese Datei als ".htaccess" in den Projekt-Hauptordner legen.
# Sie leitet alle Anfragen nach public/ um, sodass .env, storage/ usw. nie erreichbar sind.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
